<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="530.0" prefWidth="809.0" style="-fx-background-color: #14242B;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.oficina.controller.BudgetController">

    <center>
        <VBox fx:id="root" alignment="CENTER">
            <children>
                <VBox fx:id="cardContainer" maxWidth="900.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </VBox>
                <Pagination fx:id="pagination" currentPageIndex="1" prefHeight="30.0" prefWidth="810.0" />
            </children>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="250.0" spacing="12.0" style="-fx-background-color: #1E3540; -fx-background-radius: 10;">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

                  <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="Filtros" />

                  <Label style="-fx-text-fill: #AAAAAA;" text="Cliente" />
            <HBox spacing="10.0">
                <ComboBox fx:id="filterClient" maxWidth="Infinity" promptText="Selecione o cliente" HBox.hgrow="ALWAYS" />
                <Button onAction="#clientFilter" style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;" text="Filtrar" />
            </HBox>

                  <Label style="-fx-text-fill: #AAAAAA;" text="Carro" />
            <HBox spacing="10.0">
                <ComboBox fx:id="filterCar" maxWidth="Infinity" promptText="Selecione o carro" HBox.hgrow="ALWAYS" />
                <Button onAction="#carFilter" style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;" text="Filtrar" />
            </HBox>
         <VBox prefHeight="136.0" prefWidth="220.0" spacing="15.0">
            <children>
      
                                       <Label style="-fx-text-fill: #AAAAAA;" text="Data Início" />
               <DatePicker fx:id="filterDateStart" prefHeight="26.0" prefWidth="222.0" />
      
                           <Label style="-fx-text-fill: #AAAAAA;" text="Data Fim" />
               <DatePicker fx:id="filterDateEnd" prefHeight="26.0" prefWidth="222.0" />
                   <Button onAction="#periodFilter" prefHeight="26.0" prefWidth="228.0" style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;" text="Filtrar Período" />
            </children>
         </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" />

                  <Button maxWidth="Infinity" onAction="#clearFilter" style="-fx-background-color: #555555; -fx-text-fill: white; -fx-background-radius: 5;" text="Limpar" />
        </VBox>
    </right>

</BorderPane>
