<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0"
      style="-fx-background-color: #14242B;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox alignment="CENTER" maxWidth="400.0" spacing="12.0"
          style="-fx-background-color: #F4F5F7; -fx-background-radius: 10;">

        <padding>
            <Insets bottom="25" left="25" right="25" top="25"/>
        </padding>

        <Text text="Cadastro de Serviço">
            <font><Font size="24.0"/></font>
        </Text>

        <Label text="Nome"/>
        <TextField fx:id="nameField" promptText="Digite o nome"/>

        <Label text="Preço"/>
        <TextField fx:id="priceField" promptText="Digite o preço"/>

        <Button prefWidth="200.0" text="Salvar" onAction="#save"/>
        <Button prefWidth="200.0" text="Cancelar" onAction="#cancel"/>

    </VBox>
</VBox>