<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="400.0"
            prefWidth="600.0"
            style="-fx-background-color: #14242B;"
            stylesheets="@../css/sidebar.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.oficina.controller.MainController">

   <left>
      <VBox prefHeight="400.0"
            prefWidth="126.0"
            styleClass="sidebar"
            BorderPane.alignment="CENTER">

         <children>

            <Button fx:id="btnHome"
                    mnemonicParsing="false"
                    onAction="#loadHome"
                    text="Início"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnClient"
                    mnemonicParsing="false"
                    onAction="#loadClient"
                    text="Clientes"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnCar"
                    mnemonicParsing="false"
                    onAction="#loadCar"
                    text="Carros"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnService"
                    mnemonicParsing="false"
                    onAction="#loadService"
                    text="Serviços"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnPart"
                    mnemonicParsing="false"
                    onAction="#loadPart"
                    text="Peças"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnBudget"
                    mnemonicParsing="false"
                    onAction="#loadBudget"
                    text="Orçamentos"
                    styleClass="sidebar-button"/>

            <Button fx:id="btnOrder"
                    mnemonicParsing="false"
                    onAction="#loadOrder"
                    text="Ordens de Serviço"
                    styleClass="sidebar-button"/>

         </children>

      </VBox>
   </left>

   <center>
      <Text fx:id="txtCenter"
            text="Text"
            styleClass="center-title"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            BorderPane.alignment="CENTER">

         <font>
            <Font size="47.0"/>
         </font>

      </Text>
   </center>

</BorderPane>