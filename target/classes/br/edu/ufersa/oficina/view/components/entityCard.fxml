<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="80" prefWidth="500" stylesheets="@../../css/card.css" type="AnchorPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <HBox fx:id="hbContainer" alignment="CENTER_LEFT" spacing="10" styleClass="base-card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <padding>
            <Insets bottom="10" left="15" right="15" top="10" />
        </padding>

        <VBox fx:id="vbContainer" spacing="3">
            <Label fx:id="lblTitle" text="R$ 500" />
            <Label fx:id="lblDescription" text="John Doe." />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnEdit" text="✎" />
        <Button fx:id="btnDelete" onAction="#delete" text="🗑" />

    </HBox>

</fx:root>
