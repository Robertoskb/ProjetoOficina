<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<fx:root minHeight="-Infinity" prefHeight="80" prefWidth="500.0" stylesheets="@../../css/card.css" type="AnchorPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER" spacing="10" styleClass="base-card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <padding>
            <Insets bottom="10" left="15" right="15" top="10" />
        </padding>
      <Button fx:id="btnAdd" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" minHeight="-Infinity" mnemonicParsing="false" prefHeight="60.0" prefWidth="60.0" text="➕" textAlignment="CENTER" textFill="#00ff59" onAction="#add">
         <font>
            <Font size="59.0" />
         </font>
      </Button>

    </HBox>

</fx:root>
