         <children>

            <Button fx:id="btnHome" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loadHome" styleClass="sidebar-button" text="Início" />

            <Button fx:id="btnClient" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loadClient" styleClass="sidebar-button" text="Clientes" />

            <Button fx:id="btnCar" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loadCar" styleClass="sidebar-button" text="Carros" />

            <Button fx:id="btnService" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loadService" styleClass="sidebar-button" text="Serviços" />

            <Button fx:id="btnPart" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#loadPart" styleClass="sidebar-button" text="Peças" />

