<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox fx:id="root" alignment="CENTER" prefHeight="530.0" prefWidth="809.0"
      spacing="20.0"
      style="-fx-background-color: #14242B;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ufersa.oficina.controller.MenuController">

   <HBox alignment="CENTER" spacing="40.0">

      <VBox alignment="CENTER" prefWidth="220.0" prefHeight="220.0" spacing="10.0"
            style="-fx-background-color: #2ABFBF;
                     -fx-background-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 4);">
         <padding><Insets top="30" bottom="30" left="20" right="20"/></padding>

         <Text fx:id="txtOsAndamento" fill="WHITE" text="0">
            <font><Font size="64.0"/></font>
         </Text>

         <Text fill="WHITE" text="O.S Em Andamento" textAlignment="CENTER" wrappingWidth="160.0">
            <font><Font size="14.0"/></font>
         </Text>
      </VBox>

      <VBox alignment="CENTER" prefWidth="220.0" prefHeight="220.0" spacing="10.0"
            style="-fx-background-color: #A8B400;
                     -fx-background-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 4);">
         <padding><Insets top="30" bottom="30" left="20" right="20"/></padding>

         <Text fx:id="txtOsEntregues" fill="WHITE" text="0">
            <font><Font size="64.0"/></font>
         </Text>

         <Text fill="WHITE" text="O.S Entregues este mês" textAlignment="CENTER" wrappingWidth="160.0">
            <font><Font size="14.0"/></font>
         </Text>
      </VBox>

   </HBox>
</VBox>
