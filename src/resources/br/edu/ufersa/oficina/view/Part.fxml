<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #14242B;"
            prefHeight="530.0" prefWidth="809.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.oficina.controller.PartController">

    <center>
        <VBox fx:id="root" alignment="CENTER">
            <VBox fx:id="cardContainer" maxWidth="900.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
                <padding>
                    <Insets left="15.0" right="15.0"/>
                </padding>
            </VBox>
            <Pagination fx:id="pagination" currentPageIndex="1" prefHeight="30.0" prefWidth="810.0"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="12.0" style="-fx-background-color: #1E3540; -fx-background-radius: 10;"
              prefWidth="200.0">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="Filtros" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>

            <Label text="Nome" style="-fx-text-fill: #AAAAAA;"/>
            <ComboBox fx:id="filterName" maxWidth="Infinity" promptText="Selecione o nome"/>
            <Button text="Filtrar por Nome" prefWidth="170.0" onAction="#filterByName"
                    style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Label text="Fabricante" style="-fx-text-fill: #AAAAAA;"/>
            <ComboBox fx:id="filterManufacturer" maxWidth="Infinity" promptText="Selecione o fabricante"/>
            <Button text="Filtrar por Fabricante" prefWidth="170.0" onAction="#filterByManufacturer"
                    style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Label text="Modelo" style="-fx-text-fill: #AAAAAA;"/>
            <ComboBox fx:id="filterModel" maxWidth="Infinity" promptText="Selecione o modelo"/>
            <Button text="Filtrar por Modelo" prefWidth="170.0" onAction="#filterByModel"
                    style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Button text="Limpar" prefWidth="170.0" onAction="#clearFilter"
                    style="-fx-background-color: #555555; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </VBox>
    </right>

</BorderPane>