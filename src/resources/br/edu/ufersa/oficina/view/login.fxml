<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane maxHeight="343.0" maxWidth="662.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="343.0" prefWidth="662.0" stylesheets="@../css/login_style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.oficina.controller.LoginController">
   <children>
      <VBox alignment="CENTER" fillWidth="false" prefHeight="302.0" prefWidth="628.0" spacing="14.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="login-title" text="Login">
               <font>
                  <Font name="Arial" size="60.0" />
               </font>
            </Text>
            <VBox prefHeight="139.0" prefWidth="297.0" spacing="2.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="form-label" text="Email" />
                  <TextField fx:id="txtEmail" promptText="example@gmail.com" />
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="form-label" text="Senha" />
                  <PasswordField fx:id="txtPassword" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#login" text="Entrar" />
            <Text fx:id="txtError" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="error-text">
               <font>
                  <Font name="Bodoni MT" size="12.0" />
               </font>
            </Text>
         </children>
      </VBox>
   </children>
</StackPane>
