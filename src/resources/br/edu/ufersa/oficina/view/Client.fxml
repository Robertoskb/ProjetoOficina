<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane style="-fx-background-color: #14242B;"
            prefHeight="530.0" prefWidth="809.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.oficina.controller.Paginator.ClientController">

   <center>
      <VBox fx:id="root" alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="0.0" prefWidth="559.0">
               <children>
                  <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Clientes">
                     <font>
                        <Font size="40.0" />
                     </font>
                  </Text>
               </children>
            </HBox>
            <VBox fx:id="cardContainer" maxWidth="900.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
               <padding>
                  <Insets left="15.0" right="15.0"/>
               </padding>
            </VBox>
            <Pagination fx:id="pagination" currentPageIndex="1" prefHeight="30.0" prefWidth="810.0"/>
         </children>
      </VBox>
   </center>

</BorderPane>