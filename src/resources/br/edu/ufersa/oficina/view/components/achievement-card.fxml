<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           prefWidth="350"
           maxWidth="350"
           styleClass="achievement-card"
           xmlns:fx="http://javafx.com/fxml"
           stylesheets="@../../achievment.css">

    <VBox spacing="8">

        <HBox spacing="12">
            <ImageView fx:id="icon"
                       fitHeight="48"
                       fitWidth="48"
                       preserveRatio="true"/>

            <VBox spacing="4">
                <Label fx:id="titleLabel"
                       text="Conquista desbloqueada!"
                       styleClass="achievement-title"/>

                <Label fx:id="descriptionLabel"
                       text="Você concluiu uma tarefa."
                       wrapText="true"
                       styleClass="achievement-description"/>
            </VBox>
        </HBox>

        <ProgressBar fx:id="timerBar"
                     progress="1.0"
                     maxWidth="Infinity"/>
    </VBox>

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

</StackPane>